# Local dev credentials only (matches docker-compose.yml).
DATABASE_URL=postgresql://pipeline:pipeline@localhost:5433/tickets

# Only needed to run the two agents (python -m agents.<name>, or run.py --with-agents).
# Set one key. LLM_PROVIDER (gemini|claude|openai) is optional: otherwise the first configured key wins, in that order.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
# claude-opus-5-5 by default; claude-sonnet-5-5 or claude-haiku-5-5 cost less. Effort: low|medium|high.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=

# Silver uses the agent's category mapping when config/category_mapping_agent.json exists; set to baseline to force
# the hand-built config/category_mapping.json instead.
CATEGORY_MAPPING=agent

# Alerts are always written to lineage.alerts; set to true plus a Slack webhook URL to also post them.
ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=
